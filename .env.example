# Plug and Go — environment template (no secrets).
# Copy to .env.local for Next.js. Prisma CLI also reads `.env` in the project root.
#
# Named environments (required for launch): development | staging | pilot | production
# NODE_ENV=production is not the same as PNG_ENV=production.
# Staging, pilot, and production must use distinct databases and test vs live credentials.
# PNG_ENV=development
# PNG_PRODUCTION_DATABASE_HOST=
# PNG_STAGING_DATABASE_HOST=
# PNG_ALLOW_LOCAL_PRODUCTION=false
# PNG_SKIP_STARTUP_VALIDATION=false

# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Example: http://localhost:3000   or  https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection (required for Phase 4 catalogue). Never commit real credentials.
# Local project cluster: npm run db:up
# DATABASE_URL=postgresql://plugandgo@127.0.0.1:54329/plugandgo

# Staff admin (disabled unless ADMIN_ENABLED=true). Never prefix with NEXT_PUBLIC_.
# Production always denies the development adapter until an identity provider is wired.
# ADMIN_ENABLED=false
# STAFF_DEV_ROLE=super_admin           # Also: content_manager, station_operator, support, finance, technician, host_admin, host_viewer, fleet_admin, fleet_viewer. Ignored in production.
# STAFF_DEV_ACTOR_ID=dev-staff-1
# STAFF_IDENTITY_PROVIDER=
# STAFF_MFA_ENFORCED=false              # Production portals stay off until this is true AND an IdP with MFA is wired
# OPS_STAFF_REMOTE_COMMANDS_ENABLED=false
# OPS_EVIDENCE_STORAGE_PREFIX=          # Optional https prefix for technician evidence URLs

# Optional. Minutes after which an availability event becomes Stale.
# If unset, public APIs never return Available.
# AVAILABILITY_FRESHNESS_MINUTES=

# Driver authentication (Phase 7). Never prefix secrets with NEXT_PUBLIC_.
# AUTH_SECRET is required to hash OTP challenges and session tokens (min 16 characters).
# AUTH_SECRET=
# AUTH_SESSION_DAYS=30
# AUTH_OTP_EXPIRY_SECONDS=300
# AUTH_OTP_RESEND_SECONDS=60
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_SEND_PER_PHONE_HOUR=5
# AUTH_OTP_SEND_PER_IP_HOUR=10
# AUTH_OTP_VERIFY_PER_PHONE_HOUR=20
# AUTH_SESSION_COOKIE=png_driver
#
# Development-only OTP (never honoured when NODE_ENV=production):
# AUTH_DEV_OTP=true
#
# SMS delivery. Production login stays unavailable until a provider is configured.
# Do not fake success if these are unset.
# SMS_OTP_PROVIDER=                    # webhook | none
# SMS_OTP_PROVIDER_KEY=
# SMS_OTP_WEBHOOK_URL=
# SMS_OTP_WEBHOOK_TOKEN=
# SMS_OTP_FROM=
#
# Optional: register the service worker outside production builds.
# NEXT_PUBLIC_ENABLE_SW=false

# Payments and optional website booking (Phase 8). Never prefix secrets with NEXT_PUBLIC_.
# Production stays disabled until PAYMENT_PROVIDER=razorpay and all Razorpay secrets are set.
# Browser checkout return is never treated as payment success — only a signed webhook is.
# PAYMENT_PROVIDER=                        # razorpay | none
# PAYMENT_RAZORPAY_KEY_ID=
# PAYMENT_RAZORPAY_KEY_SECRET=
# PAYMENT_RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_PAYMENT_CHECKOUT_KEY=        # Public checkout key if the provider requires one in the browser
# PAYMENT_WEBHOOK_SECRET=                  # Used by the development mock webhook HMAC
# PAYMENT_DEV_MOCK=false                   # true enables mock checkout only when NODE_ENV is not production
# BOOKING_HOLD_SECONDS=900
# RECEIPT_NUMBER_PREFIX=PNG-R
# INVOICE_NUMBER_PREFIX=PNG-INV
# BOOKING_REFERENCE_PREFIX=PNG-B

# CSMS / OCPP (Phase 9). Never prefix secrets with NEXT_PUBLIC_. Never commit charger
# passwords, certificates, private keys, or production WSS secrets.
# Public web and CSMS are separately deployable. Browser clients never speak OCPP.
#
# CSMS_MODE=simulator                 # simulator | test | pilot | production
# OCPP_ENABLED=false
# OCPP_REMOTE_COMMANDS_ENABLED=false
# OCPP_PRODUCTION_CONTROL_APPROVED=false
# OCPP_HARDWARE_INVENTORY_COMPLETE=false
# OCPP_PUBLIC_LIVE_UPDATES=false
# CSMS_WSS_BASE_URL=wss://csms.example.invalid
# CSMS_CONTROL_URL=https://csms.example.invalid
# CSMS_LISTEN_HOST=127.0.0.1
# CSMS_LISTEN_PORT=9000
# CSMS_ALLOW_INSECURE_LOCAL=false     # true only for 127.0.0.1 lab listen without TLS
# CSMS_TLS_CERT_PATH=                 # filesystem path or secret store reference
# CSMS_TLS_KEY_PATH=
# CSMS_CREDENTIAL_PEPPER=             # HMAC pepper for charger Basic-auth hashes (or AUTH_SECRET)
# CSMS_INTERNAL_HMAC_SECRET=          # HMAC between CSMS control API and Next.js
# OCPP_EVENT_PUBLISHER_URL=           # CSMS process posts normalized events here
# OCPP_HEARTBEAT_INTERVAL_SECONDS=60
# OCPP_HEARTBEAT_STALE_SECONDS=180
# AVAILABILITY_FRESHNESS_MINUTES=     # still required before Available is shown
# OCPP_COMMAND_TIMEOUT_SECONDS=30
# OCPP_START_EVIDENCE_TIMEOUT_SECONDS=120
# OCPP_MAX_PAYLOAD_BYTES=65536
# OCPP_MAX_CONNECTIONS=200
# OCPP_MAX_CONNECTIONS_PER_IP=8
# OCPP_REMOTE_COMMAND_PER_DRIVER_HOUR=10
# OCPP_PILOT_STATION_IDS=             # comma-separated internal station ids; empty denies all
# OCPP_PILOT_CONNECTOR_IDS=
# OCPP_PILOT_DRIVER_IDS=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public map (Phase 5). Browser keys only — never put a server secret in NEXT_PUBLIC_*.
# Restrict each key to this site’s production and preview domains in the vendor console.
# If unset, /find-charger stays a full list experience and states that map display is unavailable.
# NEXT_PUBLIC_MAPS_PROVIDER=           # mapbox | google | none
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=     # Mapbox public token, URL-restricted
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY= # Google Maps JavaScript API browser key, HTTP-referrer restricted

# Server-only enquiry delivery (Phase 3). Never prefix with NEXT_PUBLIC_.
# If unset, contact/lead forms fail clearly and do not pretend success.
# ENQUIRY_WEBHOOK_URL=https://example.invalid/hooks/enquiries
# ENQUIRY_WEBHOOK_TOKEN=

# --- Later phases (do not set fake values; leave blank until a vendor is chosen) ---
# MAPS_API_KEY=                        # Server geocoding secret if needed later. Not used by the public finder.
# CRM_WEBHOOK_URL=
# ANALYTICS_WRITE_KEY=

# Phase 11 release flags. Unset or any value other than true is disabled (fail closed).
# Production remote charging and payment checkout stay off unless verified configuration exists.
# FLAG_PUBLIC_FINDER=false
# FLAG_PUBLISHED_CONTENT=false
# FLAG_DRIVER_OTP=false
# FLAG_PWA_PROMPT=false
# FLAG_BOOKING=false
# FLAG_PAYMENT_CHECKOUT=false
# FLAG_REFUNDS=false
# FLAG_PUBLIC_LIVE_AVAILABILITY=false
# FLAG_PILOT_REMOTE_CHARGING=false
# FLAG_PRODUCTION_REMOTE_CHARGING=false
# FLAG_OPS_PORTAL=false
# FLAG_HOST_PORTAL=false
# FLAG_FLEET_PORTAL=false
# FLAG_PUBLIC_STATUS_PAGE=false
#
# Observability webhook (optional). Leave blank until a vendor is approved. Never send PII.
# OBSERVABILITY_WEBHOOK_URL=
# OBSERVABILITY_WEBHOOK_TOKEN=
